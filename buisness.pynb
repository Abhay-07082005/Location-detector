    {
      "cell_type": "code",
      "source": [
        "\n",
        "cat_dummies = pd.get_dummies(df['category'], prefix='cat')\n",
        "for cat in CATEGORY_LIST:\n",
        "    col = f'cat_{cat}'\n",
        "    if col not in cat_dummies.columns:\n",
        "        cat_dummies[col] = 0\n",
        "X = pd.concat([df[FEATURE_COLS], cat_dummies[[f'cat_{c}' for c in CATEGORY_LIST]]], axis=1)\n",
        "\n",
        "y_sub = df[SUBSCORE_COLS]\n",
        "y_overall = df['overall_score']\n",
        "label_map = {'LOW': 0, 'MEDIUM': 1, 'HIGH': 2}\n",
        "inv_label_map = {v: k for k, v in label_map.items()}\n",
        "y_class = df['potential_level'].map(label_map)\n",
        "\n",
        "X_train, X_test, ysub_train, ysub_test, yov_train, yov_test, ycls_train, ycls_test = train_test_split(\n",
        "    X, y_sub, y_overall, y_class, test_size=0.2, random_state=42, stratify=y_class)\n",
        "\n",
        "subscore_model = MultiOutputRegressor(\n",
        "    XGBRegressor(n_estimators=350, max_depth=4, learning_rate=0.06, subsample=0.85, colsample_bytree=0.85, random_state=42)\n",
        ")\n",
        "subscore_model.fit(X_train, ysub_train)\n",
        "pred_sub = subscore_model.predict(X_test)\n",
        "print(\"Sub-score model performance:\")\n",
        "for i, col in enumerate(SUBSCORE_COLS):\n",
        "    print(f\"  {col:18s} MAE={mean_absolute_error(ysub_test[col], pred_sub[:, i]):5.2f}  R2={r2_score(ysub_test[col], pred_sub[:, i]):.3f}\")\n",
        "\n",
        "overall_model = XGBRegressor(n_estimators=350, max_depth=4, learning_rate=0.06, subsample=0.85, colsample_bytree=0.85, random_state=42)\n",
        "overall_model.fit(X_train, yov_train)\n",
        "pred_ov = overall_model.predict(X_test)\n",
        "print(f\"\\nOverall score model: MAE={mean_absolute_error(yov_test, pred_ov):.2f}  R2={r2_score(yov_test, pred_ov):.3f}\")\n",
        "\n",
        "clf_model = XGBClassifier(n_estimators=350, max_depth=4, learning_rate=0.06, subsample=0.85,\n",
        "                           colsample_bytree=0.85, random_state=42, eval_metric='mlogloss')\n",
        "clf_model.fit(X_train, ycls_train)\n",
        "pred_cls = clf_model.predict(X_test)\n",
        "print(f\"Potential-level classifier: accuracy={accuracy_score(ycls_test, pred_cls):.3f}  macro-F1={f1_score(ycls_test, pred_cls, average='macro'):.3f}\")\n",
        "\n",
        "FEATURE_COLUMNS_FULL = list(X.columns)\n"
      ],
      "metadata": {
