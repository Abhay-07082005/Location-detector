        "loc_in = input(\"\\nPaste a Google Maps link, 'lat,lng', an address, or a preset name (e.g. 'Koramangala'): \").strip()\n",
        "biz_in = input(\"Business type id (e.g. 'coffee_shop'): \").strip() or 'coffee_shop'\n",
        "sqft_in = input(f\"Business size in sq ft [default {BUSINESS_TYPES.get(biz_in, {}).get('typical_sqft', 800)}]: \").strip()\n",
        "budget_in = input(\"Budget in local currency (e.g. 1000000): \").strip()\n",
