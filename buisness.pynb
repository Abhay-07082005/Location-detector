    {
      "cell_type": "code",
      "source": [
        "\n",
        "def parse_latlng_from_gmaps_url(url: str):\n",
        "    '''Extract (lat, lng) from a pasted Google Maps URL, e.g.\n",
        "    https://www.google.com/maps/place/.../@26.1209,85.3647,15z or ...?q=26.1209,85.3647'''\n",
        "    m = re.search(r'@(-?\\d+\\.\\d+),(-?\\d+\\.\\d+)', url)\n",
        "    if not m:\n",
        "        m = re.search(r'[?&]q=(-?\\d+\\.\\d+),(-?\\d+\\.\\d+)', url)\n",
        "    if not m:\n",
        "        m = re.search(r'(-?\\d+\\.\\d+)\\s*,\\s*(-?\\d+\\.\\d+)', url)\n",
        "    if m:\n",
        "        return float(m.group(1)), float(m.group(2))\n",
        "    return None\n",
        "def geocode_google(address: str, api_key: str):\n",
        "    '''Geocode a free-text address using the Google Maps Geocoding API.'''\n",
        "    url = \"https://maps.googleapis.com/maps/api/geocode/json\"\n",
        "    resp = requests.get(url, params={\"address\": address, \"key\": api_key}, timeout=15)\n",
        "    data = resp.json()\n",
        "    if data.get(\"status\") == \"OK\" and data[\"results\"]:\n",
        "        loc = data[\"results\"][0][\"geometry\"][\"location\"]\n",
        "        formatted = data[\"results\"][0][\"formatted_address\"]\n",
        "        return loc[\"lat\"], loc[\"lng\"], formatted\n",
        "    raise ValueError(f\"Geocoding failed: {data.get('status')} — {data.get('error_message', '')}\")\n",
        "def resolve_location(user_input: str, api_key: str = \"\"):\n",
        "    '''Accepts a Maps URL, 'lat,lng', or a free-text address/place name. Returns (lat, lng, label).'''\n",
        "    user_input = user_input.strip()\n",
        "\n",
        "    if \"maps\" in user_input or \"http\" in user_input:\n",
        "        coords = parse_latlng_from_gmaps_url(user_input)\n",
        "        if coords:\n",
        "            return coords[0], coords[1], f\"Pinned location ({coords[0]:.4f}, {coords[1]:.4f})\"\n",
        "\n",
        "    m = re.match(r'^\\s*(-?\\d+\\.\\d+)\\s*,\\s*(-?\\d+\\.\\d+)\\s*$', user_input)\n",
        "    if m:\n",
        "        return float(m.group(1)), float(m.group(2)), f\"Pinned location ({m.group(1)}, {m.group(2)})\"\n",
        "\n",
        "    for name, (lat, lng) in PRESET_LOCATIONS.items():\n",
        "        if user_input.lower() in name.lower():\n",
        "            return lat, lng, name\n",
        "    if api_key:\n",
        "        lat, lng, formatted = geocode_google(user_input, api_key)\n",
        "        return lat, lng, formatted\n",
        "\n",
        "    raise ValueError(\n",
        "        \"Could not resolve this location without a Google API key. \"\n",
        "        \"Paste a Google Maps link, 'lat,lng', or one of the preset location names.\"\n",
        "    )\n",
        "\n",
        "print(\"✅ Location resolver ready. Preset locations:\", list(PRESET_LOCATIONS.keys()))\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
