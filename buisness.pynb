        "    business_type_id=biz_in if biz_in in BUSINESS_TYPES else 'coffee_shop',\n",
        "    sqft=sqft_val,\n",
        "    budget=budget_val,\n",
        "    api_key=GOOGLE_MAPS_API_KEY,\n",
        ")\n",
        "location_map\n"
