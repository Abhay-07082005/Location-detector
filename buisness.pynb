          "name": "stdout",
          "text": [
            "✅ Location resolver ready. Preset locations: ['Muzaffarpur, Bihar', 'Bandra West, Mumbai', 'Connaught Place, New Delhi', 'Koramangala, Bengaluru', 'Gachibowli, Hyderabad', 'Sector 18, Noida', 'Lower Manhattan, New York', 'Soho, London']\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "def haversine_km(lat1, lon1, lat2, lon2):\n",
        "    R = 6371.0\n",
        "    p1, p2 = math.radians(lat1), math.radians(lat2)\n",
        "    dphi = math.radians(lat2 - lat1)\n",
        "    dlmb = math.radians(lon2 - lon1)\n",
        "    a = math.sin(dphi / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dlmb / 2) ** 2\n",
        "    return 2 * R * math.asin(math.sqrt(a))\n",
        "def fetch_competitors_google(lat, lng, business_type_id, api_key, radius_m=3000):\n",
        "    cfg = PLACE_TYPE_MAP[business_type_id]\n",
        "    url = \"https://maps.googleapis.com/maps/api/place/nearbysearch/json\"\n",
        "    params = {\n",
        "        \"location\": f\"{lat},{lng}\",\n",
        "        \"radius\": radius_m,\n",
        "        \"type\": cfg[\"google_type\"],\n",
        "        \"keyword\": cfg[\"google_keyword\"],\n",
        "        \"key\": api_key,\n",
        "    }\n",
        "    resp = requests.get(url, params=params, timeout=15)\n",
        "    data = resp.json()\n",
        "    if data.get(\"status\") not in (\"OK\", \"ZERO_RESULTS\"):\n",
        "        raise RuntimeError(f\"Google Places error: {data.get('status')} — {data.get('error_message','')}\")\n",
        "\n",
        "    competitors = []\n",
        "    for place in data.get(\"results\", []):\n",
        "        loc = place[\"geometry\"][\"location\"]\n",
        "        dist = haversine_km(lat, lng, loc[\"lat\"], loc[\"lng\"])\n",
        "        competitors.append({\n",
        "            \"name\": place.get(\"name\", \"Unnamed\"),\n",
        "            \"lat\": loc[\"lat\"], \"lng\": loc[\"lng\"],\n",
        "            \"distance_km\": round(dist, 2),\n",
        "            \"rating\": place.get(\"rating\", 3.8),\n",
        "            \"user_ratings_total\": place.get(\"user_ratings_total\", 0),\n",
        "            \"source\": \"google_places\",\n",
        "        })\n",
        "    return sorted(competitors, key=lambda c: c[\"distance_km\"])\n",
        "def fetch_competitors_osm(lat, lng, business_type_id, radius_m=3000):\n",
        "    tags = PLACE_TYPE_MAP[business_type_id][\"osm_tags\"]\n",
        "    clauses = \"\".join(\n",
        "        f'node[\"{k}\"=\"{v}\"](around:{radius_m},{lat},{lng});'\n",
        "        f'way[\"{k}\"=\"{v}\"](around:{radius_m},{lat},{lng});'\n",
        "        for k, v in tags\n",
        "    )\n",
        "    query = f\"[out:json][timeout:25];({clauses});out center 80;\"\n",
        "    resp = requests.post(\"https://overpass-api.de/api/interpreter\", data={\"data\": query}, timeout=30)\n",
        "    data = resp.json()\n",
        "\n",
        "    competitors = []\n",
        "    for el in data.get(\"elements\", []):\n",
        "        elat = el.get(\"lat\") or el.get(\"center\", {}).get(\"lat\")\n",
        "        elng = el.get(\"lon\") or el.get(\"center\", {}).get(\"lon\")\n",
        "        if elat is None or elng is None:\n",
        "            continue\n",
        "        dist = haversine_km(lat, lng, elat, elng)\n",
        "        name = el.get(\"tags\", {}).get(\"name\", \"Unnamed local business\")\n",
        "        competitors.append({\n",
        "            \"name\": name, \"lat\": elat, \"lng\": elng,\n",
        "            \"distance_km\": round(dist, 2),\n",
        "            \"rating\": 3.8, \"user_ratings_total\": 50,\n",
        "            \"source\": \"openstreetmap_estimated_rating\",\n",
        "        })\n",
        "    return sorted(competitors, key=lambda c: c[\"distance_km\"])\n",
        "\n",
        "\n",
        "def get_competitors(lat, lng, business_type_id, radius_m=3000, api_key=\"\"):\n",
        "    if api_key:\n",
        "        try:\n",
        "            return fetch_competitors_google(lat, lng, business_type_id, api_key, radius_m)\n",
        "        except Exception as e:\n",
        "            print(f\"⚠️ Google Places failed ({e}); falling back to OpenStreetMap\")\n",
        "    try:\n",
        "        return fetch_competitors_osm(lat, lng, business_type_id, radius_m)\n",
        "    except Exception as e:\n",
        "        print(f\"⚠️ OpenStreetMap fetch also failed ({e}); returning empty competitor list\")\n",
        "        return []\n",
        "\n",
        "print(\"✅ Competitor-fetch functions ready\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "FLLXJo_8Vrgh",
        "outputId": "72af84d4-8cb0-45d8-b718-8b5169ae42ac"
      },
      "execution_count": 7,
      "outputs": [
        {
