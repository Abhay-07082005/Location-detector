          "name": "stdout",
          "text": [
            "✅ Competitor-fetch functions ready\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "def fetch_osm_density(lat, lng, radius_m=1000):\n",
        "    '''Counts buildings + commercial/amenity POIs in radius as a density proxy. Returns an int, or None on failure.'''\n",
        "    query = (\n",
        "        f\"[out:json][timeout:25];\"\n",
        "        f\"(node['building'](around:{radius_m},{lat},{lng});\"\n",
        "        f\"way['building'](around:{radius_m},{lat},{lng});\"\n",
        "        f\"node['shop'](around:{radius_m},{lat},{lng});\"\n",
        "        f\"node['amenity'](around:{radius_m},{lat},{lng}););\"\n",
        "        f\"out count;\"\n",
        "    )\n",
        "    try:\n",
        "        resp = requests.post(\"https://overpass-api.de/api/interpreter\", data={\"data\": query}, timeout=30)\n",
        "        data = resp.json()\n",
        "        total = int(data[\"elements\"][0][\"tags\"][\"total\"])\n",
        "        return total\n",
        "    except Exception:\n",
        "        return None\n",
        "\n",
        "\n",
        "def estimate_demographics(lat, lng, competitors, business_type_id, demographics_override=None):\n",
        "    if demographics_override:\n",
        "        d = dict(demographics_override)\n",
        "    else:\n",
        "        poi_density = fetch_osm_density(lat, lng, radius_m=1000)\n",
        "        if poi_density is None:\n",
        "            poi_density = 250\n",
        "\n",
        "        population_density = int(np.clip(poi_density * 9, 1500, 25000))\n",
        "        commercial_zone_density = 2 if poi_density > 400 else (1 if poi_density > 150 else 0)\n",
        "        foot_traffic_index = int(np.clip(poi_density / 6, 15, 100))\n",
        "\n",
        "        d = {\n",
        "            \"population_density\": population_density,\n",
        "            \"age_18_35_pct\": 45,\n",
        "            \"income_index\": 1,\n",
        "            \"employment_rate_pct\": 88,\n",
        "            \"student_working_pct\": 55,\n",
        "            \"foot_traffic_index\": foot_traffic_index,\n",
        "            \"commercial_zone_density\": commercial_zone_density,\n",
        "        }\n",
        "\n",
        "    d[\"drive_time_center_min\"] = d.get(\"drive_time_center_min\", 15)\n",
        "    d[\"distance_to_highway_km\"] = d.get(\"distance_to_highway_km\", 2.0)\n",
        "    return d\n",
        "\n",
        "print(\"✅ Demographics estimator ready\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "LXoAH0bMVuYD",
        "outputId": "89c9184e-e62d-4bd7-a608-22199bc45032"
      },
      "execution_count": 7,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "✅ Demographics estimator ready\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "FEATURE_COLS = [\n",
        "    'population_density', 'age_18_35_pct', 'income_index', 'employment_rate_pct',\n",
        "    'student_working_pct', 'foot_traffic_index', 'commercial_zone_density',\n",
        "    'competitors_1km', 'competitors_3km', 'competitors_5km', 'nearest_km',\n",
        "    'avg_rating', 'avg_reviews', 'sqft', 'budget', 'budget_ratio',\n",
        "    'drive_time_center_min', 'distance_to_highway_km',\n",
        "]\n",
        "SUBSCORE_COLS = ['demand', 'competition', 'market_fit', 'accessibility', 'cost_feasibility']\n",
        "\n",
        "\n",
        "def build_feature_row(business_type_id, sqft, budget, competitors, demographics):\n",
        "    biz = BUSINESS_TYPES[business_type_id]\n",
        "    c1 = sum(1 for c in competitors if c[\"distance_km\"] <= 1)\n",
        "    c3 = sum(1 for c in competitors if c[\"distance_km\"] <= 3)\n",
        "    c5 = sum(1 for c in competitors if c[\"distance_km\"] <= 5)\n",
        "    nearest = min((c[\"distance_km\"] for c in competitors), default=3.0)\n",
        "    avg_rating = round(np.mean([c[\"rating\"] for c in competitors]), 2) if competitors else 3.8\n",
        "    avg_reviews = int(np.mean([c[\"user_ratings_total\"] for c in competitors])) if competitors else 50\n",
        "\n",
        "    row = {\n",
        "        'population_density': demographics['population_density'],\n",
        "        'age_18_35_pct': demographics['age_18_35_pct'],\n",
        "        'income_index': demographics['income_index'],\n",
        "        'employment_rate_pct': demographics['employment_rate_pct'],\n",
        "        'student_working_pct': demographics['student_working_pct'],\n",
        "        'foot_traffic_index': demographics['foot_traffic_index'],\n",
        "        'commercial_zone_density': demographics['commercial_zone_density'],\n",
        "        'competitors_1km': c1, 'competitors_3km': c3, 'competitors_5km': c5,\n",
        "        'nearest_km': nearest, 'avg_rating': avg_rating, 'avg_reviews': avg_reviews,\n",
        "        'sqft': sqft, 'budget': budget, 'budget_ratio': budget / biz['cost_min'],\n",
        "        'drive_time_center_min': demographics['drive_time_center_min'],\n",
        "        'distance_to_highway_km': demographics['distance_to_highway_km'],\n",
        "    }\n",
        "    for cat in CATEGORY_LIST:\n",
        "        row[f'cat_{cat}'] = 1 if biz['category'] == cat else 0\n",
        "    return row, dict(competitors_1km=c1, competitors_3km=c3, competitors_5km=c5,\n",
        "                      nearest_km=nearest, avg_rating=avg_rating, avg_reviews=avg_reviews)\n",
        "\n",
        "print(\"✅ Feature builder ready\")\n"
      ],
