        "outputId": "95dacbbd-67e7-4d6f-a1a6-17b6288f8d5f"
      },
      "execution_count": 17,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "✅ analyze_location() ready — this is the full pipeline entry point\n"
          ]
        }
      ]
    },
