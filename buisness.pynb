    {
      "cell_type": "code",
      "source": [
        "\n",
        "YELP_CATEGORY_PRIORITY = [\n",
        "    ('pharmacy', ['pharmacy', 'drugstore']),\n",
        "    ('daycare', ['child care', 'day care', 'preschool']),\n",
        "    ('coaching_institute', ['tutoring', 'educational services', 'test preparation', 'language school']),\n",
        "    ('coworking', ['shared office', 'business center', 'co-working', 'coworking']),\n",
        "    ('bakery', ['bakeries', 'bakery']),\n",
        "    ('coffee_shop', ['coffee & tea', 'cafes', 'cafe']),\n",
        "    ('gym', ['gyms', 'fitness & instruction', 'trainers']),\n",
        "    ('salon', ['hair salons', 'beauty & spas', 'nail salons', 'barbers']),\n",
        "    ('grocery', ['grocery', 'convenience stores', 'supermarkets']),\n",
        "    ('clothing_boutique', [\"women's clothing\", \"men's clothing\", 'fashion', 'boutique']),\n",
        "    ('cloud_kitchen', ['food delivery services', 'ghost kitchen']),\n",
        "    ('restaurant', ['restaurants']),\n",
        "]\n",
        "\n",
        "def map_yelp_category(categories_str):\n",
        "    if not isinstance(categories_str, str):\n",
        "        return None\n",
        "    low = categories_str.lower()\n",
        "    for btype, keywords in YELP_CATEGORY_PRIORITY:\n",
        "        if any(k in low for k in keywords):\n",
        "            return btype\n",
        "    return None\n",
        "\n",
        "\n",
        "EARTH_KM = 6371.0\n",
        "\n",
        "def engineer_real_business_features(df_raw):\n",
        "    '''Turn raw Yelp business rows into engineered, model-ready features using real coordinates.'''\n",
        "    df = df_raw.copy()\n",
        "    df['business_type_id'] = df['categories'].apply(map_yelp_category)\n",
        "    df = df.dropna(subset=['business_type_id', 'latitude', 'longitude', 'city'])\n",
        "    df = df[df['is_open'].isin([0, 1])].reset_index(drop=True)\n",
        "    if len(df) == 0:\n",
        "        raise ValueError(\"No businesses matched the known category list after filtering.\")\n",
        "\n",
        "    # General local business density (any matched category) -> demographics/foot-traffic proxy\n",
        "    coords_rad_all = np.radians(df[['latitude', 'longitude']].values)\n",
        "    tree_all = BallTree(coords_rad_all, metric='haversine')\n",
        "    counts_1km_all = tree_all.query_radius(coords_rad_all, r=1.0 / EARTH_KM, count_only=True) - 1\n",
        "    df['poi_density_1km'] = counts_1km_all\n",
        "\n",
        "    # Drive-time-to-center proxy: distance to the mean lat/lng of businesses in the same city\n",
        "    city_centers = df.groupby('city')[['latitude', 'longitude']].transform('mean')\n",
        "    df['dist_to_center_km'] = [\n",
        "        haversine_km(a, b, c, d) for a, b, c, d in\n",
        "        zip(df['latitude'], df['longitude'], city_centers['latitude'], city_centers['longitude'])\n",
        "    ]\n",
        "\n",
        "    out_frames = []\n",
        "    for btype, group in df.groupby('business_type_id'):\n",
        "        group = group.reset_index(drop=True)\n",
        "        coords_rad = np.radians(group[['latitude', 'longitude']].values)\n",
        "        tree = BallTree(coords_rad, metric='haversine')\n",
        "\n",
        "        idx_1km = tree.query_radius(coords_rad, r=1.0 / EARTH_KM)\n",
        "        idx_3km = tree.query_radius(coords_rad, r=3.0 / EARTH_KM)\n",
        "        idx_5km = tree.query_radius(coords_rad, r=5.0 / EARTH_KM)\n",
        "        k = min(2, len(group))\n",
        "        nn_dist, nn_idx = tree.query(coords_rad, k=k)\n",
        "\n",
        "        ratings = group['stars'].values\n",
        "        reviews = group['review_count'].values\n",
        "\n",
        "        c1_list, c3_list, c5_list, nearest_list, avgr_list, avgn_list = [], [], [], [], [], []\n",
        "        for i in range(len(group)):\n",
        "            c1 = len(idx_1km[i]) - 1\n",
        "            c3 = len(idx_3km[i]) - 1\n",
        "            c5 = len(idx_5km[i]) - 1\n",
        "            nearest_km = float(nn_dist[i][1] * EARTH_KM) if k > 1 else 3.0\n",
        "            neigh = [j for j in idx_3km[i] if j != i]\n",
        "            avg_rating = float(np.mean(ratings[neigh])) if neigh else 3.8\n",
        "            avg_reviews = float(np.mean(reviews[neigh])) if neigh else 50.0\n",
        "            c1_list.append(c1); c3_list.append(c3); c5_list.append(c5)\n",
        "            nearest_list.append(nearest_km); avgr_list.append(avg_rating); avgn_list.append(avg_reviews)\n",
        "\n",
        "        group['competitors_1km'] = c1_list\n",
        "        group['competitors_3km'] = c3_list\n",
        "        group['competitors_5km'] = c5_list\n",
        "        group['nearest_km'] = nearest_list\n",
        "        group['avg_rating'] = avgr_list\n",
        "        group['avg_reviews'] = avgn_list\n",
        "        out_frames.append(group)\n",
        "\n",
        "    return pd.concat(out_frames, ignore_index=True)\n",
        "\n",
        "\n",
        "def build_real_training_set(df_raw, sample_per_type=1500, seed=42):\n",
        "    '''Build a FEATURE_COLS/SUBSCORE_COLS-shaped training set grounded in real Yelp outcomes + geodata.'''\n",
        "    rng = np.random.default_rng(seed)\n",
        "    df = engineer_real_business_features(df_raw)\n",
        "\n",
        "    rows = []\n",
        "    for _, r in df.iterrows():\n",
        "        biz_id = r['business_type_id']\n",
        "        biz = BUSINESS_TYPES[biz_id]\n",
        "\n",
        "        population_density = int(np.clip(r['poi_density_1km'] * 350, 1500, 25000))\n",
        "        foot_traffic_index = int(np.clip(r['poi_density_1km'] * 3, 15, 100))\n",
        "        commercial_zone_density = 2 if r['poi_density_1km'] > 25 else (1 if r['poi_density_1km'] > 8 else 0)\n",
        "        # No free source for these -> neutral defaults, matching the live inference estimator\n",
        "        age_18_35_pct = 45\n",
        "        income_index = 1\n",
        "        employment_rate_pct = 88\n",
        "        student_working_pct = 55\n",
        "\n",
        "        drive_time_center_min = int(np.clip(r['dist_to_center_km'] / 30 * 60, 2, 45))\n",
        "        distance_to_highway_km = 2.0  # no free source -> neutral default\n",
        "\n",
        "        # No public cost/size dataset exists -> simulate, same approach as the synthetic generator\n",
        "        sqft = int(np.clip(rng.normal(biz['typical_sqft'], biz['typical_sqft'] * 0.25), 100, None))\n",
        "        budget = float(np.clip(\n",
        "            rng.normal((biz['cost_min'] + biz['cost_max']) / 2, (biz['cost_max'] - biz['cost_min']) * 0.4),\n",
        "            biz['cost_min'] * 0.5, biz['cost_max'] * 2.5))\n",
        "        budget_ratio = budget / biz['cost_min']\n",
        "\n",
        "        # ---- REAL outcome-grounded target ----\n",
        "        is_open = float(r['is_open'])\n",
        "        stars_norm = float(r['stars']) / 5.0\n",
        "        reviews_norm = float(np.clip(math.log1p(r['review_count']) / math.log1p(400), 0, 1))\n",
        "        overall = np.clip(is_open * 58 + stars_norm * 27 + reviews_norm * 15 + rng.normal(0, 4), 1, 99)\n",
        "\n",
        "        # ---- sub-scores: grounded where possible, heuristic elsewhere ----\n",
        "        demand = np.clip(reviews_norm * 100 * 0.5 + foot_traffic_index * 0.5 + rng.normal(0, 5), 5, 100)\n",
        "        comp_penalty = r['competitors_1km'] * 9 + r['competitors_3km'] * 2.5\n",
        "        rating_pressure = max(0, r['avg_rating'] - 3.8) * 10\n",
        "        competition = np.clip(96 - comp_penalty - rating_pressure + (r['nearest_km'] * 6) + rng.normal(0, 5), 5, 100)\n",
        "        market_fit = np.clip((population_density / 20000) * 45 + student_working_pct * 0.25\n",
        "                              + {0: 0, 1: 8, 2: 16}[income_index] + employment_rate_pct * 0.15 + rng.normal(0, 5), 5, 100)\n",
        "        accessibility = np.clip(foot_traffic_index * 0.55 + (35 - min(drive_time_center_min, 35)) * 1.1\n",
        "                                 + max(0, 6 - distance_to_highway_km) * 3 + rng.normal(0, 5), 5, 100)\n",
        "        cost_feasibility = np.clip(35 + (budget_ratio - 1) * 55 + rng.normal(0, 6), 5, 100)\n",
        "\n",
        "        rows.append(dict(\n",
        "            business_id=biz_id, category=biz['category'],\n",
        "            population_density=population_density, age_18_35_pct=age_18_35_pct, income_index=income_index,\n",
        "            employment_rate_pct=employment_rate_pct, student_working_pct=student_working_pct,\n",
        "            foot_traffic_index=foot_traffic_index, commercial_zone_density=commercial_zone_density,\n",
        "            competitors_1km=r['competitors_1km'], competitors_3km=r['competitors_3km'], competitors_5km=r['competitors_5km'],\n",
        "            nearest_km=r['nearest_km'], avg_rating=r['avg_rating'], avg_reviews=r['avg_reviews'],\n",
        "            sqft=sqft, budget=budget, budget_ratio=budget_ratio,\n",
        "            drive_time_center_min=drive_time_center_min, distance_to_highway_km=distance_to_highway_km,\n",
        "            demand=demand, competition=competition, market_fit=market_fit,\n",
        "            accessibility=accessibility, cost_feasibility=cost_feasibility, overall_score=overall,\n",
        "        ))\n",
        "\n",
        "    out = pd.DataFrame(rows)\n",
        "    out['potential_level'] = pd.cut(out['overall_score'], bins=[0, 55, 75, 100], labels=['LOW', 'MEDIUM', 'HIGH'])\n",
        "    # Balance across business types so common Yelp categories (e.g. restaurants) don't dominate\n",
        "    out = out.groupby('business_id', group_keys=False).apply(\n",
        "        lambda g: g.sample(min(len(g), sample_per_type), random_state=seed))\n",
        "    return out.reset_index(drop=True)\n",
        "\n",
        "\n",
        "def download_yelp_business_json():\n",
        "    os.makedirs('/content/yelp_data', exist_ok=True)\n",
        "    subprocess.run(\n",
        "        ['kaggle', 'datasets', 'download', '-d', 'yelp-dataset/yelp-dataset',\n",
        "         '-f', 'yelp_academic_dataset_business.json', '-p', '/content/yelp_data'],\n",
        "        check=True, capture_output=True, text=True,\n",
        "    )\n",
        "    for z in glob.glob('/content/yelp_data/*.zip'):\n",
        "        with zipfile.ZipFile(z) as zf:\n",
        "            zf.extractall('/content/yelp_data')\n",
        "    candidates = glob.glob('/content/yelp_data/**/yelp_academic_dataset_business.json', recursive=True)\n",
        "    if not candidates:\n",
        "        raise FileNotFoundError(\"yelp_academic_dataset_business.json not found after download\")\n",
        "    return candidates[0]\n",
        "\n",
        "print(\"✅ Real-data loader functions ready\")\n"
      ],
      "metadata": {
        "id": "5UONFKaSXVVt",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "97034a8d-2c1d-4efd-c6cb-ec4331afc1d9"
      },
      "execution_count": 10,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "✅ Real-data loader functions ready\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "def generate_synthetic_dataset(n=9000, seed=42):\n",
        "    '''Documented synthetic training set — used as a fallback when real Yelp data isn't available.'''\n",
        "    rng = np.random.default_rng(seed)\n",
        "    rows = []\n",
        "    biz_ids = list(BUSINESS_TYPES.keys())\n",
        "    for _ in range(n):\n",
        "        biz_id = rng.choice(biz_ids)\n",
        "        biz = BUSINESS_TYPES[biz_id]\n",
        "        category = biz['category']\n",
        "\n",
        "        population_density = int(rng.integers(2000, 22000))\n",
        "        age_18_35_pct = int(rng.integers(20, 65))\n",
        "        income_index = int(rng.choice([0, 1, 2], p=[0.35, 0.4, 0.25]))\n",
        "        employment_rate_pct = int(rng.integers(70, 98))\n",
        "        student_working_pct = int(rng.integers(25, 85))\n",
        "        foot_traffic_index = int(rng.integers(20, 100))\n",
        "        commercial_zone_density = int(rng.choice([0, 1, 2], p=[0.3, 0.4, 0.3]))\n",
        "\n",
        "        zone_lambda = {0: 2, 1: 6, 2: 12}[commercial_zone_density]\n",
        "        competitors_1km = int(rng.poisson(max(0.5, zone_lambda * (population_density / 12000))))\n",
        "        competitors_3km = competitors_1km + int(rng.poisson(zone_lambda * 1.8))\n",
        "        competitors_5km = competitors_3km + int(rng.poisson(zone_lambda * 1.2))\n",
        "        nearest_km = round(float(rng.uniform(0.05, 3.0)) if competitors_1km > 0 else float(rng.uniform(1.0, 5.0)), 2)\n",
        "        avg_rating = round(float(np.clip(rng.normal(4.0, 0.4), 2.5, 5.0)), 1)\n",
        "        avg_reviews = int(max(5, rng.normal(200, 150)))\n",
        "\n",
        "        sqft = int(np.clip(rng.normal(biz['typical_sqft'], biz['typical_sqft'] * 0.25), 100, None))\n",
        "        budget = float(np.clip(\n",
        "            rng.normal((biz['cost_min'] + biz['cost_max']) / 2, (biz['cost_max'] - biz['cost_min']) * 0.4),\n",
        "            biz['cost_min'] * 0.5, biz['cost_max'] * 2.5))\n",
        "        budget_ratio = budget / biz['cost_min']\n",
        "        drive_time_center_min = int(rng.integers(3, 35))\n",
        "        distance_to_highway_km = round(float(rng.uniform(0.2, 8.0)), 1)\n",
        "\n",
        "        income_boost = {0: 0, 1: 8, 2: 16}[income_index]\n",
        "        demand = np.clip(0.45 * foot_traffic_index + 0.35 * age_18_35_pct + 0.05 * student_working_pct\n",
        "                          + income_boost - 5 + rng.normal(0, 6), 5, 100)\n",
        "\n",
        "        comp_penalty = competitors_1km * 9 + competitors_3km * 2.5\n",
        "        rating_pressure = max(0, avg_rating - 3.8) * 10\n",
        "        competition = np.clip(96 - comp_penalty - rating_pressure + (nearest_km * 6) + rng.normal(0, 5), 5, 100)\n",
        "\n",
        "        market_fit = np.clip((population_density / 20000) * 45 + student_working_pct * 0.25 + income_boost\n",
        "                              + employment_rate_pct * 0.15 + rng.normal(0, 5), 5, 100)\n",
        "\n",
        "        accessibility = np.clip(foot_traffic_index * 0.55 + (35 - min(drive_time_center_min, 35)) * 1.1\n",
        "                                 + max(0, 6 - distance_to_highway_km) * 3 + rng.normal(0, 5), 5, 100)\n",
        "\n",
        "        cost_feasibility = np.clip(35 + (budget_ratio - 1) * 55 + rng.normal(0, 6), 5, 100)\n",
        "\n",
        "        overall = demand * 0.30 + competition * 0.20 + market_fit * 0.20 + cost_feasibility * 0.15 + accessibility * 0.15\n",
        "        overall = float(np.clip(overall + rng.normal(0, 3), 1, 99))\n",
        "\n",
        "        row = dict(business_id=biz_id, category=category,\n",
        "                   population_density=population_density, age_18_35_pct=age_18_35_pct,\n",
        "                   income_index=income_index, employment_rate_pct=employment_rate_pct,\n",
        "                   student_working_pct=student_working_pct, foot_traffic_index=foot_traffic_index,\n",
        "                   commercial_zone_density=commercial_zone_density,\n",
        "                   competitors_1km=competitors_1km, competitors_3km=competitors_3km, competitors_5km=competitors_5km,\n",
        "                   nearest_km=nearest_km, avg_rating=avg_rating, avg_reviews=avg_reviews,\n",
        "                   sqft=sqft, budget=budget, budget_ratio=budget_ratio,\n",
        "                   drive_time_center_min=drive_time_center_min, distance_to_highway_km=distance_to_highway_km,\n",
        "                   demand=demand, competition=competition, market_fit=market_fit,\n",
        "                   accessibility=accessibility, cost_feasibility=cost_feasibility, overall_score=overall)\n",
        "        rows.append(row)\n",
        "\n",
        "    df = pd.DataFrame(rows)\n",
        "    df['potential_level'] = pd.cut(df['overall_score'], bins=[0, 55, 75, 100], labels=['LOW', 'MEDIUM', 'HIGH'])\n",
        "    return df\n",
        "\n",
        "print(\"✅ Synthetic fallback generator ready\")\n"
      ],
      "metadata": {
