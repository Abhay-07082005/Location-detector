      "cell_type": "code",
      "source": [
        "\n",
        "def explain_row(feature_row_df):\n",
        "    '''Return top positive/negative SHAP contributors as human-readable strings for one prediction.'''\n",
        "    sv = explainer.shap_values(feature_row_df)[0]\n",
        "    contributions = sorted(zip(feature_row_df.columns, sv), key=lambda x: -abs(x[1]))\n",
        "    pretty_names = {\n",
        "        'population_density': 'population density', 'age_18_35_pct': 'young-adult population share',\n",
        "        'income_index': 'income level', 'employment_rate_pct': 'employment rate',\n",
        "        'student_working_pct': 'student/working population', 'foot_traffic_index': 'foot traffic',\n",
        "        'commercial_zone_density': 'commercial zone density', 'competitors_1km': 'competitors within 1km',\n",
        "        'competitors_3km': 'competitors within 3km', 'competitors_5km': 'competitors within 5km',\n",
        "        'nearest_km': 'distance to nearest competitor', 'avg_rating': 'avg competitor rating',\n",
        "        'avg_reviews': 'avg competitor review volume', 'sqft': 'business size',\n",
        "        'budget': 'budget', 'budget_ratio': 'budget vs. minimum required cost',\n",
        "        'drive_time_center_min': 'drive time to city center', 'distance_to_highway_km': 'distance to highway',\n",
        "    }\n",
        "    pros, cons = [], []\n",
        "    for name, val in contributions[:8]:\n",
        "        label = pretty_names.get(name, name.replace('cat_', '').replace('_', ' '))\n",
        "        if val > 0.5:\n",
        "            pros.append(f\"✓ {label.capitalize()} is working in this location's favor\")\n",
        "        elif val < -0.5:\n",
        "            cons.append(f\"⚠ {label.capitalize()} is dragging the score down\")\n",
        "    return pros[:5], cons[:5]\n",
        "\n",
        "print(\"✅ Explainability helper ready\")\n"
      ],
      "metadata": {
        "id": "dyZ6XgDlYLBI",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "cd61d4eb-9621-404b-815b-f636d62879c0"
      },
      "execution_count": 15,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "✅ Explainability helper ready\n"
          ]
        }
      ]
