    {
      "cell_type": "code",
      "source": [
        "\n",
        "def render_dashboard(location_label, lat, lng, business_type_id, sqft, budget,\n",
        "                      overall_score, success_probability, sub_scores, potential_level, pros, cons):\n",
        "    biz = BUSINESS_TYPES[business_type_id]\n",
        "    currency_amt = f\"₹{budget:,.0f}\"\n",
        "    bar = lambda v: \"█\" * int(v / 5) + \"░\" * (20 - int(v / 5))\n",
        "\n",
        "    print(\"┌\" + \"─\" * 47 + \"┐\")\n",
        "    print(\"│\" + \"BUSINESS FEASIBILITY\".center(47) + \"│\")\n",
        "    print(\"│\" + \" \" * 47 + \"│\")\n",
        "    print(\"│\" + f\"{overall_score:.0f} / 100\".center(47) + \"│\")\n",
        "    print(\"│\" + f\"{potential_level} POTENTIAL\".center(47) + \"│\")\n",
        "    print(\"│\" + f\"Estimated success probability: {success_probability:.0f}%\".center(47) + \"│\")\n",
        "    print(\"├\" + \"─\" * 47 + \"┤\")\n",
        "    print(\"│ Location\".ljust(48) + \"│\")\n",
        "    print(f\"│ {location_label}\"[:48].ljust(48) + \"│\")\n",
        "    print(\"│ Business\".ljust(48) + \"│\")\n",
        "    print(f\"│ {biz['name']}\"[:48].ljust(48) + \"│\")\n",
        "    print(\"│ Business Size\".ljust(48) + \"│\")\n",
        "    print(f\"│ {sqft:,} sq ft\"[:48].ljust(48) + \"│\")\n",
        "    print(\"│ Budget\".ljust(48) + \"│\")\n",
        "    print(f\"│ {currency_amt}\"[:48].ljust(48) + \"│\")\n",
        "    print(\"├\" + \"─\" * 47 + \"┤\")\n",
        "    labels = {'demand': 'DEMAND', 'competition': 'COMPETITION', 'market_fit': 'MARKET FIT',\n",
        "              'accessibility': 'ACCESSIBILITY', 'cost_feasibility': 'COST FEASIBILITY'}\n",
        "    for key, label in labels.items():\n",
        "        v = sub_scores[key]\n",
        "        print(f\"│ {label}\".ljust(48) + \"│\")\n",
        "        print(f\"│ {bar(v)} {v:.0f}/100\"[:48].ljust(48) + \"│\")\n",
        "    print(\"├\" + \"─\" * 47 + \"┤\")\n",
        "    print(\"│ KEY FACTORS\".ljust(48) + \"│\")\n",
        "    for p in pros:\n",
        "        print(f\"│ {p}\"[:48].ljust(48) + \"│\")\n",
        "    for c in cons:\n",
        "        print(f\"│ {c}\"[:48].ljust(48) + \"│\")\n",
        "    print(\"├\" + \"─\" * 47 + \"┤\")\n",
        "    verdict = \"GO — strong potential for this business here.\" if potential_level == \"HIGH\" else (\n",
        "        \"CAUTION — viable, but mitigate the flagged risks.\" if potential_level == \"MEDIUM\" else\n",
        "        \"NO-GO — this combination looks weak; see alternatives.\")\n",
        "    print(\"│ RECOMMENDATION\".ljust(48) + \"│\")\n",
        "    print(f\"│ {verdict}\"[:48].ljust(48) + \"│\")\n",
        "    print(\"└\" + \"─\" * 47 + \"┘\")\n",
        "\n",
        "\n",
        "def plot_subscores(sub_scores):\n",
        "    labels = ['Demand', 'Competition', 'Market Fit', 'Accessibility', 'Cost Feasibility']\n",
        "    values = [sub_scores['demand'], sub_scores['competition'], sub_scores['market_fit'],\n",
        "              sub_scores['accessibility'], sub_scores['cost_feasibility']]\n",
        "    colors = ['#2E7D32' if v >= 70 else '#F9A825' if v >= 50 else '#C62828' for v in values]\n",
        "    plt.figure(figsize=(7, 3.5))\n",
        "    bars = plt.barh(labels, values, color=colors)\n",
        "    plt.xlim(0, 100)\n",
        "    for bar, v in zip(bars, values):\n",
        "        plt.text(v + 1.5, bar.get_y() + bar.get_height() / 2, f\"{v:.0f}\", va='center')\n",
        "    plt.title(\"Location sub-scores\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "def plot_map(lat, lng, competitors, location_label):\n",
        "    m = folium.Map(location=[lat, lng], zoom_start=14)\n",
        "    folium.Marker([lat, lng], tooltip=location_label, icon=folium.Icon(color='blue', icon='star')).add_to(m)\n",
        "    for c in competitors[:40]:\n",
        "        folium.CircleMarker(\n",
        "            [c['lat'], c['lng']], radius=5, color='red', fill=True, fill_opacity=0.7,\n",
        "            tooltip=f\"{c['name']} ({c['distance_km']} km, ⭐{c['rating']})\"\n",
        "        ).add_to(m)\n",
        "    return m\n",
        "\n",
        "\n",
        "def analyze_location(location_input, business_type_id, sqft, budget,\n",
        "                      api_key=\"\", radius_m=3000, demographics_override=None, show_map=True):\n",
        "    assert business_type_id in BUSINESS_TYPES, f\"Unknown business_type_id. Choose from {list(BUSINESS_TYPES)}\"\n",
        "\n",
        "    lat, lng, location_label = resolve_location(location_input, api_key)\n",
        "    competitors = get_competitors(lat, lng, business_type_id, radius_m=radius_m, api_key=api_key)\n",
        "    demographics = estimate_demographics(lat, lng, competitors, business_type_id, demographics_override)\n",
        "    feature_row, comp_summary = build_feature_row(business_type_id, sqft, budget, competitors, demographics)\n",
        "\n",
        "    X_row = pd.DataFrame([feature_row])[FEATURE_COLUMNS_FULL]\n",
        "    sub_pred = subscore_model.predict(X_row)[0]\n",
        "    sub_scores = dict(zip(SUBSCORE_COLS, [float(np.clip(v, 1, 99)) for v in sub_pred]))\n",
        "    overall_score = float(np.clip(overall_model.predict(X_row)[0], 1, 99))\n",
        "    success_probability = float(np.clip(1 / (1 + math.exp(-(overall_score - 55) / 12)) * 100, 1, 99))\n",
        "    cls_pred = int(clf_model.predict(X_row)[0])\n",
        "    potential_level = inv_label_map[cls_pred]\n",
        "\n",
        "    pros, cons = explain_row(X_row)\n",
        "\n",
        "    render_dashboard(location_label, lat, lng, business_type_id, sqft, budget,\n",
        "                      overall_score, success_probability, sub_scores, potential_level, pros, cons)\n",
        "    plot_subscores(sub_scores)\n",
        "\n",
        "    result = {\n",
        "        'location': {'lat': lat, 'lng': lng, 'label': location_label},\n",
        "        'business_type': BUSINESS_TYPES[business_type_id]['name'],\n",
        "        'sqft': sqft, 'budget': budget,\n",
        "        'overall_score': round(overall_score, 1),\n",
        "        'success_probability': round(success_probability, 1),\n",
        "        'potential_level': potential_level,\n",
        "        'sub_scores': {k: round(v, 1) for k, v in sub_scores.items()},\n",
        "        'competitors': {'total_found': len(competitors), **comp_summary, 'list': competitors[:20]},\n",
        "        'demographics': demographics,\n",
        "        'pros': pros, 'cons': cons,\n",
        "        'trained_on': dataset_source,\n",
        "    }\n",
        "\n",
        "    m = None\n",
        "    if show_map:\n",
        "        m = plot_map(lat, lng, competitors, location_label)\n",
        "\n",
        "    return result, m\n",
        "\n",
        "print(\"✅ analyze_location() ready — this is the full pipeline entry point\")\n"
      ],
      "metadata": {
        "id": "nuAdHwUoYQfJ",
        "colab": {
          "base_uri": "https://localhost:8080/"
