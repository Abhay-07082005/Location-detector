    {
      "cell_type": "code",
      "source": [
        "\n",
        "def load_training_dataset(use_real_data=True, sample_per_type=1500):\n",
        "    if use_real_data:\n",
        "        try:\n",
        "            path = download_yelp_business_json()\n",
        "            print(f\"Downloaded -> {path}\")\n",
        "            df_raw = pd.read_json(path, lines=True)\n",
        "            df_real = build_real_training_set(df_raw, sample_per_type=sample_per_type)\n",
        "            print(f\"✅ Built REAL-data training set: {len(df_real)} rows, grounded in is_open/stars/review_count + real competitor geodata\")\n",
        "            return df_real, \"real (Yelp Open Dataset)\"\n",
        "        except Exception as e:\n",
        "            print(f\"⚠️ Could not load real Yelp data ({e})\")\n",
        "            print(\"   Falling back to the synthetic dataset. To use real data: run the Kaggle credentials cell above, then re-run this cell.\")\n",
        "    df_syn = generate_synthetic_dataset(9000)\n",
        "    return df_syn, \"synthetic\"\n",
        "\n",
        "\n",
        "df, dataset_source = load_training_dataset(use_real_data=True)\n",
        "print(f\"\\nUsing {dataset_source} training data: {df.shape[0]} rows, {df.shape[1]} columns\")\n",
        "df.head()\n"
      ],
